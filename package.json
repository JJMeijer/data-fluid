{
  "name": "data-fluid",
  "version": "1.0.0",
  "description": "Event driven datalayer prototype",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build:dev": "node esbuild.config.js",
    "build": "npm run clean && NODE_ENV=production node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write . \"**/*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "\"https://github.com/JJMeijer/data-fluid\""
  },
  "bugs": {
    "url": "https://github.com/JJMeijer/data-fluid/issues"
  },
  "author": "JJMeijer",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^2.0.21",
    "prettier": "^3.2.5",
    "tslib": "^2.5.0",
    "typescript": "^5.4.5",
    "esbuild": "^0.20.2",
    "vitest": "^1.5.0",
    "@vitest/coverage-v8": "^1.5.0",
    "rimraf": "^5.0.5"
  }
}
